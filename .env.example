# Firebase web config for Google sign-in + sync (public values; see docs/google-login-setup.md).
# Copy to .env.local for local builds; set the same variables in Vercel → Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# the app's own domain (vercel.json proxies /__/auth to Firebase)
VITE_FIREBASE_AUTH_DOMAIN=your-app.vercel.app
# local tests only: talk to the Firebase emulators instead of the real project
# VITE_USE_EMULATORS=1
